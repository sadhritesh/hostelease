
@model HostelEase.UI.ViewModels.AccountViewModels.ForgetPasswordViewModel;
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<form asp-action="SendResetPasswordLink" asp-controller="account" method="post">
	<div>
		<label asp-for="Email"></label>
		<div>
			<input asp-for="Email"/>
			<span asp-validation-for="Email" style="color:red"></span>
		</div>
	</div>
	<div>
		<button type="submit">Send Reset Password Link</button>
	</div>
</form>


