@model HostelEase.UI.ViewModels.AccountViewModels.LoginViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers


<form asp-controller="Account" asp-action="Login">
	<div>
		<label asp-for="Email"></label>
		<div>
			<input asp-for="Email" />
			<span asp-validation-for="Email" style="color:red"></span>
		</div>
	</div>
	<div>
		<label asp-for="Password"></label>
		<div>
			<input asp-for="Password" />
			<span asp-validation-for="Password" style="color:red"></span>
		</div>
	</div>
	<div>
		<div>
			<input asp-for="RememberMe" />
			<label asp-for="RememberMe"></label>
			<span asp-validation-for="RememberMe" style="color:red"></span>
		</div>
	</div>
	<div>
		<button type="submit">Login</button>
		<a asp-controller="Account" asp-action="SendResetPasswordLink">forgot Password</a>
	</div>
</form>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}